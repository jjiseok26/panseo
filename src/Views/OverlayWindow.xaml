<Window x:Class="Panseo.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panseo Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True"
        IsHitTestVisible="False">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- 1. 칠판/화이트보드 배경 레이어 -->
        <Border x:Name="BlackboardLayer" Background="#DD1A2421" Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- 2. 스포트라이트 마스크 레이어 -->
        <Path x:Name="SpotlightLayer" Fill="#B3000000" Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- 3. 판서 캔버스 (도형, 선, 화살표, 텍스트 등이 그려지는 레이어) -->
        <Canvas x:Name="DrawingCanvas" IsHitTestVisible="True" Background="Transparent" />

        <!-- 4. 임시 드로잉 레이어 (드래그 중 미리보기 선/도형) -->
        <Canvas x:Name="TempCanvas" IsHitTestVisible="False" />

        <!-- 5. 인라인 텍스트 입력 상자 (텍스트 입력 시만 표시) -->
        <Canvas x:Name="TextEditorCanvas" IsHitTestVisible="True">
            <Border x:Name="TextEditorBox" Visibility="Collapsed"
                    Background="#E61E1E2E" BorderBrush="#50FFFFFF" BorderThickness="1.5" CornerRadius="6" Padding="6">
                <StackPanel Orientation="Vertical">
                    <TextBox x:Name="InlineTextBox" 
                             MinWidth="140"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0"
                             FontSize="20"
                             FontFamily="Malgun Gothic, Segoe UI"
                             AcceptsReturn="True"
                             TextWrapping="Wrap" />
                    <TextBlock Text="[Enter] 완료  |  [Esc] 취소" Foreground="#88FFFFFF" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- 6. 마우스 포인터 효과 레이어 (하이라이트 원, 레이저 점, 클릭 링 등) -->
        <Canvas x:Name="PointerCanvas" IsHitTestVisible="False" />
    </Grid>
</Window>
